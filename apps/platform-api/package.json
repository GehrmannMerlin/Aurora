{
  "name": "@aurora/platform-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Aurora platform HTTP service (Fastify): session/csrf/origin plugins + PLT-03 identity operation handlers",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/integration/** --exclude test/package-entry.test.ts",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "test:coverage": "vitest run --coverage --no-file-parallelism --exclude test/package-entry.test.ts"
  },
  "dependencies": {
    "@aurora/platform-audit": "workspace:*",
    "@aurora/platform-contract": "workspace:*",
    "@aurora/platform-credentials": "workspace:*",
    "@aurora/platform-email": "workspace:*",
    "@aurora/platform-identity": "workspace:*",
    "@aurora/platform-organization": "workspace:*",
    "@aurora/platform-project-governance": "workspace:*",
    "@aurora/platform-session": "workspace:*",
    "fastify": "5.10.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@vitest/coverage-v8": "4.1.10",
    "node-pg-migrate": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "aurora": {
    "layer": "service"
  }
}
