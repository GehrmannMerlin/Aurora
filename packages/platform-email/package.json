{
  "name": "@aurora/platform-email",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Aurora platform transactional email data layer: EmailDeliveryPort, local/Preview console adapter and the transactional outbox consumer",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/integration/** --exclude test/package-entry.test.ts",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "test:coverage": "vitest run --coverage --no-file-parallelism --exclude test/package-entry.test.ts",
    "test:package": "pnpm build && vitest run test/package-entry.test.ts"
  },
  "dependencies": {
    "@alicloud/credentials": "2.4.5",
    "@alicloud/dm20151123": "1.10.2",
    "@alicloud/openapi-core": "1.0.8",
    "@darabonba/typescript": "1.0.5",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "aurora": {
    "layer": "data"
  }
}
