# Aurora public-preview shared environment. Copy to the server at
# /opt/aurora-preview/shared/.env and chmod 600. NEVER commit this file.
# The DB password is generated server-side; this example shows only the keys.

# Strong random password for the preview PostgreSQL (generated on the server,
# never printed or committed). Required by compose.yaml.
PREVIEW_DB_PASSWORD=

# Release id: set automatically by the deploy script (e.g. 20260808-013000).
RELEASE_ID=

# Public Preview must explicitly select the real provider. `console` is a
# controlled local-only non-delivering mode.
EMAIL_DELIVERY_MODE=aliyun
ALIYUN_DIRECT_MAIL_ACCOUNT_NAME=support@notifications.aurora.ah.cn
ALIYUN_DIRECT_MAIL_FROM_ALIAS=Aurora
ALIYUN_DIRECT_MAIL_REGION_ID=cn-hangzhou
# Optional endpoint override; omit to use the official SDK regional default.
# ALIYUN_DIRECT_MAIL_ENDPOINT=

EMAIL_PROVIDER_TIMEOUT_MS=10000
EMAIL_OUTBOX_PROCESSING_TIMEOUT_MS=300000
EMAIL_OUTBOX_RETRY_BASE_DELAY_MS=1000
EMAIL_OUTBOX_RETRY_MAX_DELAY_MS=300000

# Optional protected fallback only when an ECS RAM role/default credential
# chain is unavailable. Leave blank here; set only in server shared/.env.
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
