{
  "name": "@aurora/ingestion-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Aurora data ingestion synchronous HTTP service",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/integration/**",
    "test:integration": "vitest run test/integration --no-file-parallelism"
  },
  "dependencies": {
    "@aurora/event-schema": "workspace:*",
    "@aurora/ingestion-inbox": "workspace:*",
    "fastify": "5.10.0",
    "pg": "8.22.0",
    "@aurora/ingestion-credentials": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "node-pg-migrate": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "aurora": {
    "layer": "service"
  }
}
