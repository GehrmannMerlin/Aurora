# Aurora public-preview shared environment. Copy to the server at
# /opt/aurora-preview/shared/.env and chmod 600. NEVER commit this file.
# The DB password is generated server-side; this example shows only the keys.

# Strong random password for the preview PostgreSQL (generated on the server,
# never printed or committed). Required by compose.yaml.
PREVIEW_DB_PASSWORD=

# Release id: set automatically by the deploy script (e.g. 20260808-013000).
RELEASE_ID=
