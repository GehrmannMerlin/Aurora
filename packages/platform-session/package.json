{
  "name": "@aurora/platform-session",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Aurora platform session data layer: Redis-authoritative sessions (SHA-256 digest keys), CSRF secrets and host-only session cookie options",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/integration/** --exclude test/package-entry.test.ts",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "test:coverage": "vitest run --coverage --no-file-parallelism --exclude test/package-entry.test.ts",
    "test:package": "pnpm build && vitest run test/package-entry.test.ts"
  },
  "dependencies": {
    "redis": "5.8.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "aurora": {
    "layer": "data"
  }
}
