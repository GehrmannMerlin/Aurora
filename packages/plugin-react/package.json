{
  "name": "@aurora/plugin-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Aurora React 18 framework adapter (Error Boundary, framework error bridge, StrictMode-safe lifecycle)",
  "sideEffects": false,
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/package-entry.test.ts",
    "test:coverage": "vitest run --coverage --exclude test/package-entry.test.ts",
    "test:package": "pnpm build && vitest run test/package-entry.test.ts",
    "test:browser": "pnpm build && playwright test --config playwright.config.ts --project=chromium-desktop",
    "test:matrix": "pnpm build && playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@aurora/browser": "workspace:*",
    "@aurora/core": "workspace:*",
    "@aurora/event-schema": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "aurora": {
    "layer": "sdk-framework"
  }
}
